{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "a7e28ac2-5060-4312-abd9-867a7eb1d4bd",
  "developer": {
    "name": "Tagent Dev",
    "websiteUrl": "https://github.com/Preetham1983",
    "privacyUrl": "https://github.com/Preetham1983",
    "termsOfUseUrl": "https://github.com/Preetham1983"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Tagent",
    "full": "Tagent - AI Enterprise Assistant"
  },
  "description": {
    "short": "AI assistant for Teams, Jira, Calendar & more",
    "full": "Tagent is an enterprise AI assistant. Mention it to schedule meetings, send messages, manage Jira tasks, and more."
  },
  "accentColor": "#0078D4",
  "bots": [
    {
      "botId": "f83fd1c2-97bb-490a-92bc-3131fb0d4a6e",
      "scopes": [
        "personal",
        "team",
        "groupChat"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": [
            "personal",
            "groupChat"
          ],
          "commands": [
            {
              "title": "schedule meeting",
              "description": "Schedule a Teams meeting — e.g. user@company.com at 2pm June 1 desc: Sync"
            },
            {
              "title": "send message",
              "description": "Send a direct message — e.g. user@company.com - Hello!"
            },
            {
              "title": "my meetings",
              "description": "Show today's calendar events"
            },
            {
              "title": "jira issues",
              "description": "List Jira issues in your project"
            }
          ]
        }
      ]
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": ["*.vercel.app"]
}