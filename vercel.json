{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/orchestrate", "destination": "/api/index" },
    { "source": "/approve", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/settings/:path*", "destination": "/api/index" },
    { "source": "/auth/:path*", "destination": "/api/index" },
    { "source": "/tool/:path*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
