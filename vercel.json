{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "frontend/dist" }
    },
    {
      "src": "vercel_index.py",
      "use": "@vercel/python",
      "config": {
        "memory": 1024,
        "maxDuration": 60
      }
    },
    {
      "src": "vercel_messages.py",
      "use": "@vercel/python",
      "config": {
        "memory": 1024,
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    { "src": "/api/messages", "dest": "/vercel_messages.py" },
    { "src": "/orchestrate", "dest": "/vercel_index.py" },
    { "src": "/approve", "dest": "/vercel_index.py" },
    { "src": "/health", "dest": "/vercel_index.py" },
    { "src": "/settings/(.*)", "dest": "/vercel_index.py" },
    { "src": "/auth/(.*)", "dest": "/vercel_index.py" },
    { "src": "/tool/(.*)", "dest": "/vercel_index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
