{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "frontend/dist" }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "backend/services/orchestrator-service/src/**",
          "backend/services/orchestrator-service/main.py",
          "backend/services/mcp-tools-service/src/**",
          "backend/services/mcp-tools-service/main.py"
        ]
      }
    },
    {
      "src": "api/messages.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "backend/services/orchestrator-service/src/**",
          "backend/services/orchestrator-service/main.py",
          "backend/services/mcp-tools-service/src/**",
          "backend/services/mcp-tools-service/main.py"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/messages", "dest": "/api/messages.py" },
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
