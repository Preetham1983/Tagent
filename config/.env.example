# Microsoft Bot Framework
MS_APP_ID=
MS_APP_PASSWORD=

# Microsoft Graph (App Registration)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Jira
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///tagent.db

# Redis (for caching/sessions)
REDIS_URL=redis://localhost:6379

# Google Calendar MCP (official @cocal/google-calendar-mcp)
# Set to the absolute path of your gcp-oauth.keys.json (Desktop app OAuth credentials)
# Run once after setting: npx @cocal/google-calendar-mcp auth
GCAL_MCP_OAUTH_CREDENTIALS=/absolute/path/to/gcp-oauth.keys.json
