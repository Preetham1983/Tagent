# ─────────────────────────────────────────────────────────────
# Tagent — Orchestrator Service Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────

# ── LLM (Azure OpenAI) ───────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_MODEL=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_TEMPERATURE=0.0

# ── Microsoft Graph API ───────────────────────────────────────
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# off | auto
GRAPH_MODE=off

# ── Microsoft Teams Bot ───────────────────────────────────────
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=

# ── Jira ─────────────────────────────────────────────────────
JIRA_BASE_URL=https://<your-org>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# ── GitHub ───────────────────────────────────────────────────
GITHUB_TOKEN=

# ── Notion ───────────────────────────────────────────────────
NOTION_TOKEN=

# ── Google Calendar ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: path to gcp-oauth.keys.json
GCAL_MCP_OAUTH_CREDENTIALS=

# ── DACL MCP Server ───────────────────────────────────────────
DACL_MCP_URL=http://localhost:8080/sse
DACL_MCP_API_KEY=

# ── MCP Tools subprocess ──────────────────────────────────────
MCP_EXTERNAL_ENABLED=true
MCP_EXTERNAL_COMMAND=python
MCP_EXTERNAL_ARGS=["main.py"]
MCP_EXTERNAL_CWD=../mcp-tools-service
MCP_EXTERNAL_TYPE=stdio
MCP_EXTERNAL_TIMEOUT_SECONDS=20

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///tagent.db

# ── Redis (optional — for persistent checkpoints) ────────────
REDIS_URL=redis://localhost:6379

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
